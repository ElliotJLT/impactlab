# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
#
#   cp .env.example .env.local
#
# Never commit a real key. It burns the team's event credits and rotating it
# mid-build costs everyone time.

# Anthropic API key — from the credits Anthropic provided at the event.
# Server-side only. Do NOT prefix with NEXT_PUBLIC_ (that ships it to the browser).
ANTHROPIC_API_KEY=sk-ant-...
